PRODUCT_NAME=TeddReader

// Debug installs beside Release rather than replacing it, so a build under test never costs the
// reader the library and reading positions held by the build they actually use.
PRODUCT_BUNDLE_IDENTIFIER=com.tedd.teddreader.TeddReader$(TEAM_ID)
PRODUCT_BUNDLE_IDENTIFIER[config=Debug]=com.tedd.teddreader.TeddReader$(TEAM_ID).dev
INFOPLIST_KEY_CFBundleDisplayName=TeddReader
INFOPLIST_KEY_CFBundleDisplayName[config=Debug]=TeddReader dev

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

GOOGLE_DRIVE_IOS_CLIENT_ID=308193602832-rrs7lnn2id6kks11gfcm57m2cglpta15.apps.googleusercontent.com
GOOGLE_DRIVE_IOS_URL_SCHEME=com.googleusercontent.apps.308193602832-rrs7lnn2id6kks11gfcm57m2cglpta15
GOOGLE_DRIVE_IOS_REDIRECT_URI=$(GOOGLE_DRIVE_IOS_URL_SCHEME):/oauthredirect
