	<true/>
	<key>GoogleDriveClientID</key>
	<string>$(GOOGLE_DRIVE_IOS_CLIENT_ID)</string>
	<key>GoogleDriveRedirectURI</key>
	<string>$(GOOGLE_DRIVE_IOS_REDIRECT_URI)</string>
	<key>GoogleDriveURLScheme</key>
